# Local template only. Never commit the populated .env file.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Base32 secret behind the Angel One TOTP authenticator. It is used locally to
# create the short-lived code and is never returned by the API.
ANGEL_TOTP_SECRET=
# Match these network identity values to the Angel One SmartAPI application.
ANGEL_CLIENT_LOCAL_IP=127.0.0.1
ANGEL_CLIENT_PUBLIC_IP=
ANGEL_MAC_ADDRESS=
LIVE_TRADING_ENABLED=false

# Cloud persistence. Publishable is safe for the browser; secret is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
VITE_CLOUD_MODE=false
VITE_ALLOW_SIGNUP=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stateless job and Telegram webhook authentication. Generate long random values.
INTERNAL_JOB_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=
PUBLIC_APP_URL=
APP_TIMEZONE=Asia/Kolkata
SCAN_UNIVERSE=NIFTY500
SCAN_TOP_LIMIT=5
MARKET_DATA_PROVIDER=nse_mcp
PAPER_CAPITAL_INR=50000
RISK_PER_TRADE_PCT=1
MAX_OPEN_POSITIONS=5

# Optional: use another validated non-secret runtime configuration file.
SIGNALDESK_CONFIG_PATH=

# Production container variables are documented in .env.production.example.
